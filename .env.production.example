# =============================================================================
# AgroMaître — Production Environment Variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.production.example .env
#   2. Fill in every value marked with <CHANGE_ME>
#   3. NEVER commit the actual .env file to Git
#      (it's already listed in .gitignore)
#
# On the VPS, this file is written automatically by the GitHub Actions
# deploy job. You only need it locally for manual docker compose runs.
# =============================================================================

# ── Node / Express ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
# Individual components — assembled into DATABASE_URL by docker-compose.prod.yml
DB_USER=agromaitre
DB_PASSWORD=<CHANGE_ME_use_openssl_rand_base64_32>
DB_NAME=agromaitre

# Full connection string (used if you run the backend outside Docker)
DATABASE_URL=postgresql://agromaitre:<DB_PASSWORD>@localhost:5432/agromaitre?schema=public

# ── Application Domains ───────────────────────────────────────────────────────
# Frontend SPA domain
DOMAIN=app.agromaitre.io

# Allowed CORS origins for the backend API
# Multiple origins: "https://app.agromaitre.io,https://staging.agromaitre.io"
CORS_ORIGIN=https://app.agromaitre.io

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Found in Firebase Console → Project Settings → Service Accounts → Generate new key
FIREBASE_PROJECT_ID=<CHANGE_ME>
FIREBASE_CLIENT_EMAIL=<CHANGE_ME>@<project>.iam.gserviceaccount.com

# IMPORTANT: The private key contains literal \n characters.
# Wrap the entire value in double quotes and keep the \n as-is.
# Example: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<CHANGE_ME>\n-----END PRIVATE KEY-----\n"

# ── Let's Encrypt / Traefik ───────────────────────────────────────────────────
# Email used for certificate expiry notifications from Let's Encrypt
ACME_EMAIL=<CHANGE_ME>@yourdomain.com

# ── Image Registry ────────────────────────────────────────────────────────────
# GitHub repository slug (owner/repo) — used to pull images from ghcr.io
# Example: myorg/agromaitre
GITHUB_REPOSITORY=<CHANGE_ME>

# Docker image tag to deploy. Use "latest" for production or a specific SHA.
IMAGE_TAG=latest
